APP_NAME="Clínica Vida Salud"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/La_Paz

SESSION_NAME=vidasalud_session
SESSION_LIFETIME=7200
SESSION_SECURE=false

DB_HOST=db
DB_PORT=5432
DB_DATABASE=clinica
DB_USERNAME=clinica
DB_PASSWORD=clinica
DB_SSLMODE=prefer
DB_APP_ROLE=clinica_app

MAIL_DRIVER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM=no-reply@vidasalud.test
MAIL_FROM_NAME="Clínica Vida Salud"
MAIL_SMTP_AUTH=false
MAIL_TIMEOUT=10

KIOSK_DEVICE_KEY=dev-kiosk-key
KIOSK_HMAC_SECRET=dev-hmac-secret-change-me
KIOSK_TOKEN_TTL=600

UPLOAD_MAX_MB=2
