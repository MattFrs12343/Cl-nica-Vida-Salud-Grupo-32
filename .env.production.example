APP_NAME="Clínica Vida Salud"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio.com
APP_TIMEZONE=America/La_Paz

SESSION_NAME=vidasalud_session
SESSION_LIFETIME=7200
SESSION_SECURE=true

# Neon/Railway: usa la cadena SSL del proveedor.
DB_HOST=tu-host.neon.tech
DB_PORT=5432
DB_DATABASE=clinica
DB_USERNAME=clinica
DB_PASSWORD=cambia-esta-clave
DB_SSLMODE=require
DB_APP_ROLE=clinica_app

# Brevo SMTP (free tier).
MAIL_DRIVER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=tu-usuario-brevo
MAIL_PASSWORD=tu-clave-smtp-brevo
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@tu-dominio.com
MAIL_FROM_NAME="Clínica Vida Salud"
MAIL_SMTP_AUTH=true
MAIL_TIMEOUT=10

# Genera valores aleatorios y no reutilices los de desarrollo.
KIOSK_DEVICE_KEY=cambia-por-un-valor-aleatorio
KIOSK_HMAC_SECRET=cambia-por-un-secreto-de-64-caracteres
KIOSK_TOKEN_TTL=600

UPLOAD_MAX_MB=2
