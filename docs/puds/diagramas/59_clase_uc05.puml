@startuml
allowmixing
left to right direction
skinparam defaultFontName Arial
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
skinparam nodesep 20
skinparam ranksep 30
skinparam class {
  BackgroundColor #FDF6E3
  BorderColor #8C6D4F
  FontColor #3A2A1E
  FontSize 10
}
skinparam class<<table>> {
  BackgroundColor #EAF4FB
  BorderColor #0A6EBD
  FontColor #0B3C5D
}
skinparam actor {
  BackgroundColor #F4CCCC
  BorderColor #990000
  FontSize 10
}
actor "Paciente" as PAC
actor "Recepcionista" as REC
class "ReservaWebView" as RV <<boundary>> {
  + especialidad
  + medico
  + fecha
  + slot
  + confirmar()
}
class "AgendaView" as AV <<boundary>> {
  + buscarPaciente()
  + programar()
}
class "AuthController" as AC <<control>> {
  + autenticar()
  + autorizarRol()
}
class "CitaService" as CS <<control>> {
  + registrarCita()
  + revalidarSlot()
  + generarCodigo()
}
class "DisponibilidadService" as DS <<control>> {
  + calcularSlots()
  + validarCupo()
}
package "Tablas PostgreSQL" as TABLAS {
  class "pacientes" as TP <<table>> {
    + id : integer
    + ci : varchar
    + nombres : varchar
    + sexo : sexo
  }
  class "medicos" as TM <<table>> {
    + id : integer
    + nombres : varchar
    + duracion_cita_min : smallint
  }
  class "especialidades" as TE <<table>> {
    + id : integer
    + nombre : varchar
    + sexo_permitido : sexo_permitido
    + edad_min : smallint
    + edad_max : smallint
  }
  class "horarios" as TH <<table>> {
    + id : integer
    + medico_id : integer
    + dia_semana : smallint
    + hora_inicio : time
    + hora_fin : time
    + cupos_web : smallint
    + cupos_kiosco : smallint
  }
  class "citas" as TC <<table>> {
    + id : integer
    + codigo : varchar
    + paciente_id : integer
    + medico_id : integer
    + especialidad_id : integer
    + fecha : date
    + hora_inicio : time
    + estado : estado_cita
  }
  class "fichas" as TF <<table>> {
    + id : integer
    + cita_id : integer
    + canal : canal_ficha
    + codigo_acceso : varchar
  }
}
PAC --> RV
REC --> AV
AV --> AC
AV --> CS
RV --> CS
CS --> DS
CS --> TC
CS --> TF
DS --> TH
DS --> TC
DS --> TM
DS --> TE
AC --> TABLAS
@enduml
