@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0A6EBD
  ArrowColor #0A6EBD
  FontColor #0B3C5D
  FontSize 11
}
package "Vista / Interfaz" {
  boundary "LandingUI" as B1 <<boundary>>
  boundary "ReservaWebUI" as B2 <<boundary>>
  boundary "KioscoUI" as B3 <<boundary>>
  boundary "PanelRecepcionUI" as B4 <<boundary>>
  boundary "PanelMedicoUI" as B5 <<boundary>>
}
package "Control / Coordinación" {
  control "ReservaController" as C1 <<control>>
  control "KioscoController" as C2 <<control>>
  control "CitaService" as C3 <<control>>
  control "DisponibilidadService" as C4 <<control>>
  control "ConsultaService" as C5 <<control>>
}
package "Entidades del dominio" {
  entity "Paciente" as E1 <<entity>>
  entity "Medico" as E2 <<entity>>
  entity "Especialidad" as E3 <<entity>>
  entity "Horario" as E4 <<entity>>
  entity "Cita" as E5 <<entity>>
  entity "Ficha" as E6 <<entity>>
  entity "Consulta" as E7 <<entity>>
  entity "Receta" as E8 <<entity>>
}
B1 --> C1
B2 --> C1
B3 --> C2
B4 --> C3
B5 --> C5
C1 --> C3
C1 --> C4
C2 --> C3
C2 --> C4
C3 --> E1
C3 --> E2
C3 --> E3
C3 --> E5
C3 --> E6
C4 --> E2
C4 --> E4
C5 --> E7
C5 --> E8
E1 --> E5
E2 --> E5
E3 --> E5
E5 --> E6
E5 --> E7
E7 --> E8
@enduml
