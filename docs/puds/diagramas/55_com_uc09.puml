@startuml
allowmixing
skinparam defaultFontName Arial
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 60
skinparam object {
  BackgroundColor #FDF6E3
  BorderColor #8C6D4F
  FontColor #3A2A1E
  FontSize 12
}
skinparam actor {
  BackgroundColor #F4CCCC
  BorderColor #990000
  FontSize 12
}
actor "Recepcionista" as A
object "AgendaView" as V <<boundary>>
object "AuthController" as AC <<control>>
object "CitaService" as C <<control>>
object "DisponibilidadService" as D <<control>>
database "PostgreSQL" as DB
A -- V : 1 → iniciarSesion()\n6 → buscarPaciente(ci)\n9 → seleccionar especialidad, médico, fecha y hora\n14 → confirmarCita()\n21 ← mostrarComprobante()
V -- AC : 2 → autenticar(usuario, clave)\n5 ← sesión autorizada
AC -- DB : 3 → SELECT usuarios\n4 ← usuario + rol
V -- DB : 7 → SELECT pacientes\n8 ← paciente
V -- D : 10 → consultarDisponibilidad()\n13 ← slotsDisponibles
D -- DB : 11 → SELECT horarios + citas + bloqueos\n12 ← datos\n17 → SELECT ... FOR UPDATE\n18 ← slotLibre
V -- C : 15 → registrarCita(origen=recepción)\n20 ← confirmar(cita, ficha)
C -- D : 16 → revalidarDisponibilidad()
C -- DB : 19 → INSERT citas + fichas
@enduml
