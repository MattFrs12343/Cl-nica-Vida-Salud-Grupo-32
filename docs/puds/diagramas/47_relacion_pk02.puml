@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam nodesep 16
skinparam ranksep 32
skinparam folder {
  BackgroundColor #FDF6E3
  BorderColor #5B4636
  FontColor #3A2A1E
  FontSize 13
}
skinparam usecase {
  BackgroundColor #EAF4FB
  BorderColor #0A6EBD
  FontColor #0B3C5D
  FontSize 11
}
left to right direction
folder "PK-02\nCitas y\nagenda" as PK02
usecase "UC08 Gestionar\npacientes" as UC08
usecase "UC09 Programar\ncita" as UC09
usecase "UC10 Reprogramar\ncita" as UC10
usecase "UC11 Cancelar cita\nen recepción" as UC11
usecase "UC12 Controlar\nasistencia" as UC12
usecase "UC13 Gestionar\nreconsultas" as UC13
usecase "UC14 Consultar agenda\ne historial" as UC14
usecase "UC04 Iniciar sesión\n(PK-01)" as UC04 #F4F8FC
PK02 ..> UC08 : <<trace>>
PK02 ..> UC09 : <<trace>>
PK02 ..> UC10 : <<trace>>
PK02 ..> UC11 : <<trace>>
PK02 ..> UC12 : <<trace>>
PK02 ..> UC13 : <<trace>>
PK02 ..> UC14 : <<trace>>
UC09 ..> UC04 : <<include>>
UC11 ..> UC14 : <<extend>>
UC13 ..> UC12 : <<extend>>
@enduml
