@startuml
allowmixing
skinparam defaultFontName Arial
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 60
skinparam object {
  BackgroundColor #FDF6E3
  BorderColor #8C6D4F
  FontColor #3A2A1E
  FontSize 12
}
skinparam actor {
  BackgroundColor #F4CCCC
  BorderColor #990000
  FontSize 12
}
actor "Paciente" as A
object "ReservaWebView" as V <<boundary>>
object "CitaService" as C <<control>>
object "DisponibilidadService" as D <<control>>
database "PostgreSQL" as DB
A -- V : 1 → seleccionarEspecialidad()\n7 → confirmarReserva()\n14 ← mostrarFicha()
V -- C : 2 → buscarMedicos()\n8 → registrarCita()\n13 ← confirmar(cita, ficha)
C -- D : 3 → consultarDisponibilidad()\n9 → revalidarDisponibilidad()
D -- DB : 4 → SELECT horarios + citas + bloqueos\n10 → SELECT ... FOR UPDATE
DB -- D : 5 ← datos\n11 ← slotLibre
D -- V : 6 ← slotsDisponibles
C -- DB : 12 → INSERT citas + fichas
@enduml
