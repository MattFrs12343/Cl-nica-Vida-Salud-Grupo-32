@startuml
allowmixing
skinparam defaultFontName Arial
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 60
skinparam object {
  BackgroundColor #FDF6E3
  BorderColor #8C6D4F
  FontColor #3A2A1E
  FontSize 12
}
skinparam actor {
  BackgroundColor #F4CCCC
  BorderColor #990000
  FontSize 12
}
actor "Paciente\nen kiosco" as A
object "KioscoView" as V <<boundary>>
object "KioscoController" as K <<control>>
object "CitaService" as C <<control>>
object "FichaService" as F <<control>>
database "PostgreSQL" as DB
A -- V : 1 → iniciarSesionKiosco()\n3 → ingresarCI()\n7 → seleccionar especialidad, médico y slot\n13 → confirmarReserva()\n21 ← imprimirFicha()
V -- K : 2 → firmarToken()\n4 → identificarPaciente(ci)\n8 → consultarDisponibilidad(cupo kiosco)\n14 → registrarCita(origen=kiosco)\n20 ← mostrarFichaQR()
K -- DB : 5 → SELECT pacientes\n6 ← paciente
K -- C : 9 → calcularSlots(medico, fecha, kiosco)\n15 → registrarCita(paciente, medico, slot)
C -- DB : 10 → SELECT horarios + citas + bloqueos\n11 ← datos\n16 → INSERT citas
K -- F : 17 → emitirFicha(cita)\n19 ← ficha(código, acceso)
F -- DB : 18 → INSERT fichas + UPDATE citas
V -- C : 12 ← slotsDisponibles
@enduml
