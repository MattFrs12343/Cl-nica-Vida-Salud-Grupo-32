skinparam ranksep 45
skinparam ArrowColor #0B3C5D
skinparam actor {
  BackgroundColor #FBE4E4
  BorderColor #B85450
  FontColor #0B3C5D
  FontSize 12
}
skinparam usecase {
  BackgroundColor #EAF4FB
  BorderColor #0A6EBD
