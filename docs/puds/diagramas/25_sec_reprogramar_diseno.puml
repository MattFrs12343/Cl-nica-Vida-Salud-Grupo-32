@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam sequence {
  ArrowColor #0A6EBD
  ActorBorderColor #0A6EBD
  LifeLineBorderColor #9CC3E5
  LifeLineBackgroundColor #F7FBFF
  ParticipantBorderColor #0A6EBD
  ParticipantBackgroundColor #EAF4FB
  FontSize 10
}
autonumber
actor "Recepcionista" as RCP
participant "AgendaView" as V
participant "CitaController" as C
participant "CitaService" as S
participant "DisponibilidadService" as D
participant "CitaModel" as M
participant "MailService" as MAIL
database "PostgreSQL" as DB
RCP -> V : abre la cita y elige reprogramar
V -> C : GET /api/citas/{id}
C -> M : buscarPorId(id)
M -> DB : SELECT cita, paciente y médico
DB --> M : datos de la cita
M --> C : cita
C --> V : cita y estado actual
RCP -> V : selecciona nueva fecha y hora
V -> C : GET /api/disponibilidad?medico=&fecha=
C -> D : calcular(medico_id, fecha, canal)
D --> C : slots disponibles
C --> V : horarios disponibles
RCP -> V : confirma el nuevo horario
V -> C : PUT /api/citas/{id}/reprogramar
C -> S : reprogramar(cita_id, nueva_fecha, nueva_hora)
S -> M : validarEstado(cita)
M --> S : programada o confirmada
S -> D : revalidar nueva disponibilidad
D -> DB : SELECT ... FOR UPDATE
DB --> D : slot libre
S -> M : actualizar fecha, hora y estado
M -> DB : UPDATE cita + historial de estados
S -> MAIL : notificarCambio(paciente, cita)
S --> C : cita reprogramada
C --> V : 200 OK
V --> RCP : confirmación del cambio
@enduml
