@startuml
allowmixing
skinparam defaultFontName Arial
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 60
skinparam object {
  BackgroundColor #FDF6E3
  BorderColor #8C6D4F
  FontColor #3A2A1E
  FontSize 12
}
skinparam actor {
  BackgroundColor #F4CCCC
  BorderColor #990000
  FontSize 12
}
actor "Médico" as A
object "HistoriaView" as V <<boundary>>
object "ConsultaService" as C <<control>>
object "PedidoService" as P <<control>>
database "PostgreSQL" as DB
A -- V : 1 → abrirCita(citaId)\n6 → registrarConsulta()\n10 → agregarReceta()\n13 → generarOrden()\n17 ← mostrarPedido()
V -- C : 2 → consultarCita(citaId)\n5 ← formulario de consulta\n7 → crearConsulta(datos)\n9 ← consultaCreada
C -- DB : 3 → SELECT citas + pacientes\n4 ← datos\n8 → INSERT consultas + UPDATE citas
V -- P : 11 → crearReceta(detalle)\n14 → crearOrden(estudios)\n16 ← pedidoGenerado
P -- DB : 12 → INSERT recetas + detalle\n15 → INSERT ordenes + detalle
@enduml
